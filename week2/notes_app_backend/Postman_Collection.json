{
  "info": {
    "name": "Notes App Backend API",
    "description": "Postman Collection for Notes App Backend with User Auth & CRUD operations on Notes",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Smith\",\n  \"email\": \"alice@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "http://localhost:5002/api/auth/register",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5002",
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "http://localhost:5002/api/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5002",
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Get Current User (Me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer YOUR_TOKEN_HERE" }],
            "url": {
              "raw": "http://localhost:5002/api/auth/me",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5002",
              "path": ["api", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Notes",
      "item": [
        {
          "name": "Create Note",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer YOUR_TOKEN_HERE" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"MERN Stack Architecture\",\n  \"content\": \"MongoDB, Express, React, Node.js integration details.\",\n  \"category\": \"Study\",\n  \"tags\": [\"mern\", \"express\", \"node\"],\n  \"isPinned\": true\n}"
            },
            "url": {
              "raw": "http://localhost:5002/api/notes",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5002",
              "path": ["api", "notes"]
            }
          }
        },
        {
          "name": "Get All Notes",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer YOUR_TOKEN_HERE" }],
            "url": {
              "raw": "http://localhost:5002/api/notes",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5002",
              "path": ["api", "notes"]
            }
          }
        },
        {
          "name": "Get Note By ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer YOUR_TOKEN_HERE" }],
            "url": {
              "raw": "http://localhost:5002/api/notes/:id",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5002",
              "path": ["api", "notes", ":id"]
            }
          }
        },
        {
          "name": "Update Note",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer YOUR_TOKEN_HERE" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Note Title\",\n  \"isPinned\": false\n}"
            },
            "url": {
              "raw": "http://localhost:5002/api/notes/:id",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5002",
              "path": ["api", "notes", ":id"]
            }
          }
        },
        {
          "name": "Delete Note",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer YOUR_TOKEN_HERE" }],
            "url": {
              "raw": "http://localhost:5002/api/notes/:id",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5002",
              "path": ["api", "notes", ":id"]
            }
          }
        }
      ]
    }
  ]
}
